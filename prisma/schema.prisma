generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BENEFICIARIO
  TECNICO
  DECISOR
  FINANCIADOR
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  RETURNED
  APPROVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(BENEFICIARIO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subprojects      Subproject[]      @relation("SubprojectBeneficiary")
  reports          QuarterlyReport[]
  visits           FieldVisit[]
  pme              PME?
  technicalReports TechnicalReport[]
}

model PME {
  id       String       @id @default(cuid())
  name     String
  nif      String?      @unique
  contact  String?
  address  String?
  sector   String?
  userId   String       @unique
  user     User         @relation(fields: [userId], references: [id])
  projects Subproject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subproject {
  id              String    @id @default(cuid())
  name            String
  description     String?
  agreementNumber String    @unique
  startDate       DateTime
  endDate         DateTime
  location        String
  totalBudget     Float
  beneficiaryId   String
  beneficiary     User      @relation("SubprojectBeneficiary", fields: [beneficiaryId], references: [id])
  pmeId           String?
  pme             PME?      @relation(fields: [pmeId], references: [id])
  status          String    @default("EM_CURSO") // EM_CURSO, ATRASADO, CONCLUIDO
  planFileName    String?
  planFileUrl     String?
  planSubmittedAt DateTime?
  planStatus      String    @default("DRAFT") // DRAFT, PENDING, APPROVED, RETURNED
  planReviewNotes String?

  budgetCategories BudgetCategory[]
  indicators       Indicator[]
  reports          QuarterlyReport[]
  technicalReports TechnicalReport[]
  disbursements    Disbursement[]
  visits           FieldVisit[]
  safeguards       Safeguard[]
  activities       Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  alerts    Alert[]
}

model BudgetCategory {
  id              String     @id @default(cuid())
  name            String
  allocatedAmount Float
  subprojectId    String
  subproject      Subproject @relation(fields: [subprojectId], references: [id])

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Indicator {
  id           String     @id @default(cuid())
  name         String
  targetValue  Float
  unit         String
  subprojectId String
  subproject   Subproject @relation(fields: [subprojectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuarterlyReport {
  id             String       @id @default(cuid())
  period         String // e.g., "Q1 2026"
  status         ReportStatus @default(DRAFT)
  submissionDate DateTime?
  reviewNotes    String?
  reviewedAt     DateTime?

  mainActivity        String?
  progressDescription String?
  fundsUsed           Float?
  challenges          String?
  safeguardsNotes     String?

  subprojectId String
  subproject   Subproject @relation(fields: [subprojectId], references: [id])

  submitterId String
  submitter   User   @relation(fields: [submitterId], references: [id])

  expenses    Expense[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime

  categoryId String
  category   BudgetCategory @relation(fields: [categoryId], references: [id])

  reportId String
  report   QuarterlyReport @relation(fields: [reportId], references: [id])

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id       String @id @default(cuid())
  fileName String
  fileUrl  String
  fileType String
  size     Int

  reportId String?
  report   QuarterlyReport? @relation(fields: [reportId], references: [id])

  technicalReportId String?
  technicalReport   TechnicalReport? @relation("TechnicalReportAttachments", fields: [technicalReportId], references: [id])

  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id])

  createdAt DateTime @default(now())
}

model Disbursement {
  id            String    @id @default(cuid())
  phase         String
  amount        Float
  scheduledDate DateTime
  actualDate    DateTime?
  status        String    @default("PENDING") // PENDING, COMPLETED, CANCELLED

  subprojectId String
  subproject   Subproject @relation(fields: [subprojectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FieldVisit {
  id            String    @id @default(cuid())
  scheduledDate DateTime
  actualDate    DateTime?
  findings      String?
  status        String    @default("PLANNED") // PLANNED, COMPLETED

  subprojectId String
  subproject   Subproject @relation(fields: [subprojectId], references: [id])

  inspectorId String
  inspector   User   @relation(fields: [inspectorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Safeguard {
  id          String @id @default(cuid())
  type        String // ENVIRONMENTAL, SOCIAL
  description String
  status      String @default("COMPLIANT") // COMPLIANT, NON_COMPLIANT, RESOLVED

  subprojectId String
  subproject   Subproject @relation(fields: [subprojectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TechnicalReport {
  id             String       @id @default(cuid())
  period         String // e.g., "Q1 2026"
  content        String
  status         ReportStatus @default(DRAFT)
  submissionDate DateTime?

  subprojectId String
  subproject   Subproject @relation(fields: [subprojectId], references: [id])

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  attachments Attachment[] @relation("TechnicalReportAttachments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id           String      @id @default(cuid())
  type         String
  title        String
  message      String
  status       String      @default("PENDING") // PENDING, SENT, READ
  channel      String      @default("EMAIL") // EMAIL, SMS, BOTH
  dueDate      DateTime?
  sentAt       DateTime?
  subprojectId String?
  subproject   Subproject? @relation(fields: [subprojectId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Activity {
  id           String     @id @default(cuid())
  order        Int        @default(0)
  description  String
  responsible  String?
  startDate    DateTime?
  endDate      DateTime?
  budget       Float?
  indicator    String?
  subprojectId String
  subproject   Subproject @relation(fields: [subprojectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
